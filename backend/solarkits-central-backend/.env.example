# ─────────────────────────────────────────────────────────────────────────────
# Solarkits Central Backend — Environment Variable Reference
# Copy this file to .env and fill in real values.
# DO NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server ---
PORT=5000
IPV4=http://localhost
NODE_ENV=development

# ─── MongoDB Connection ───────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority


# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ─── JWT / Key Authentication ─────────────────────────────────────────────────
PRIVATE_KEY_PATH=src/keys/private.key
PUBLIC_KEY_PATH=src/keys/public.key
JWT_ACCESS_SECRET=<change_me_access_secret>
JWT_REFRESH_SECRET=<change_me_refresh_secret>
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=2d
COOKIE_ACCESS_EXPIRY=900000
COOKIE_REFRESH_EXPIRY=172800000
AUTH_JWT_EXPIRES=15m
SET_PASSCODE_JWT_EXPIRES=3m
AUTH_JWT_REFRESH_EXPIRES=2d
AUTH_JWT_ACCESS_EXPIRES=17m

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>
# R11: KYC documents MUST use private delivery + signed URLs
# CLOUDINARY_KYC_UPLOAD_PRESET=<private_preset_name>
# CLOUDINARY_SIGNED_URL_EXPIRY_SECONDS=300

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_SID=<your_twilio_sid>
TWILIO_AUTH_TOKEN=<your_twilio_auth_token>
TWILIO_WHATSAPP_NUMBER=+14155238886

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_ID=<your_razorpay_key_id>
RAZORPAY_KEY=<your_razorpay_key_secret>
# R8: Webhook secret for payment signature validation
RAZORPAY_WEBHOOK_SECRET=<your_razorpay_webhook_secret>

# ─── Nodemailer ───────────────────────────────────────────────────────────────
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=465
NODEMAILER_SECURE=true
NODEMAILER_USER=<your_email@example.com>
NODEMAILER_PASS=<your_app_password>
NODEMAILER_FROM=<your_email@example.com>
EMAIL_USER=<your_email@example.com>
EMAIL_PASS=<your_app_password>

# ─── SMS / Bulk SMS ───────────────────────────────────────────────────────────
SMS_AUTH_KEY=<your_sms_auth_key>
SMS_SENDER_ID=<SENDER>
DLT_TE_ID=<your_dte_id>

# ─── Auto Seed (development only) ────────────────────────────────────────────
SUPER_ADMIN_NAME=<Admin Name>
SUPER_ADMIN_EMAIL=<admin@example.com>
SUPER_ADMIN_PHONE_CODE=+91
SUPER_ADMIN_PHONE=<10_digit_mobile>

# ─────────────────────────────────────────────────────────────────────────────
# Quick eKYC GST Verification (Phase R2)
# Provider: <confirm exact provider — Karza / SignDesk / Masters India / other>
# DO NOT hard-code credentials. Always use environment variables.
# ─────────────────────────────────────────────────────────────────────────────
QUICKEKYC_PROVIDER=mock
# Supported values: mock | sandbox | production
# Set to 'mock' in development. Change to 'production' only after provider onboarding.

QUICKEKYC_BASE_URL=https://api.<provider>.com/v1
# Full base URL for the Quick eKYC API. Confirm exact URL from provider docs.

QUICKEKYC_API_KEY=<your_quickekyc_api_key>
# API key issued by Quick eKYC / provider. Keep strictly secret.

QUICKEKYC_API_SECRET=<your_quickekyc_api_secret>
# API secret / HMAC signing key. Used for request signing if required by provider.

QUICKEKYC_WEBHOOK_SECRET=<your_quickekyc_webhook_secret>
# Webhook signature validation secret. Used to verify inbound async callbacks.
# Leave blank if provider does not support webhooks.

QUICKEKYC_TIMEOUT_MS=10000
# HTTP request timeout in milliseconds for GST verification calls. Default: 10000 (10s).

QUICKEKYC_RETRY_ATTEMPTS=2
# Number of retry attempts on network timeout or 5xx errors. Default: 2.

QUICKEKYC_RETRY_DELAY_MS=1000
# Delay in milliseconds between retry attempts. Default: 1000 (1s).

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting (Phase R1)
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_WINDOW_MS=900000
# Time window for auth/login rate limiting in ms. Default: 900000 (15 min).

RATE_LIMIT_AUTH_MAX=10
# Max login attempts per IP within the window. Default: 10.

RATE_LIMIT_GST_WINDOW_MS=60000
# Time window for GST verification rate limiting in ms. Default: 60000 (1 min).

RATE_LIMIT_GST_MAX=5
# Max GST verification requests per IP per window. Default: 5.

RATE_LIMIT_OTP_WINDOW_MS=300000
# Time window for OTP rate limiting in ms. Default: 300000 (5 min).

RATE_LIMIT_OTP_MAX=5
# Max OTP requests per IP per window. Default: 5.

# ─────────────────────────────────────────────────────────────────────────────
# Settlement Engine (Phase R9)
# ─────────────────────────────────────────────────────────────────────────────
SETTLEMENT_TRIGGER=delivery_plus_window
# Supported: delivery_plus_window | manual | payment_confirmation

SETTLEMENT_RETURN_WINDOW_DAYS=7
# Days after delivery before settlement becomes eligible. Default: 7.

SETTLEMENT_PLATFORM_COMMISSION_PCT=0
# Default platform commission percentage (0-100). Configurable per reseller/product in DB.

SETTLEMENT_PGW_CHARGE_PCT=2
# Default payment gateway charge percentage. Default: 2%.

# ─────────────────────────────────────────────────────────────────────────────
# MongoDB Multi-Database Migration Tool (migrate/)
# Used ONLY during one-time migration. Safe to remove after migration completes.
# DO NOT commit .env with real values — this file uses placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# Source databases (old legacy databases to migrate FROM)
OLD_USER_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/emergesun_cms_users?retryWrites=true&w=majority
OLD_GEOLOCATION_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/emergesun_geolocations?retryWrites=true&w=majority
OLD_COMPANY_WAREHOUSES_URI=mongodb+srv://<user>:<password>@<cluster>/emergesun_company_warehouses?retryWrites=true&w=majority
OLD_CORE_DB_URI=mongodb+srv://<user>:<password>@<cluster>/emergesun_core_db?retryWrites=true&w=majority
OLD_INDIA_CORE_DB_URI=mongodb+srv://<user>:<password>@<cluster>/emergesun_india_core_db?retryWrites=true&w=majority
OLD_INDIA_SOLARSHOP_URI=mongodb+srv://<user>:<password>@<cluster>/emergesun_india_solarshop?retryWrites=true&w=majority
OLD_GEOLOCATION_BOUNDARIES_URI=mongodb+srv://<user>:<password>@<cluster>/geolocations

# Destination database (new unified database to migrate INTO)
NEW_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/solarkits_central_db?retryWrites=true&w=majority

# Optional migration tuning
# MIGRATE_BATCH_SIZE=500
# MIGRATE_CONCURRENCY=2
